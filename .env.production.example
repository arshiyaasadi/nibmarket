# ── Zone: production (nibmarket) ─────────────────────────────
# Copy to .env on the live server and set a strong AUTH_SECRET.
# After changing APP_ENV, rebuild: docker compose up -d --build
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

API_SERVICE_MODE=api
AUTH_SECRET=<generate-strong-secret-at-least-32-chars>

APP_PORT=3000
