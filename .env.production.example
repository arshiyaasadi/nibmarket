# ── Zone: production (nibmarket) — live DNS for server 2 / club-docker ──
# Used by docker-compose.prod.yml as .env.production
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

API_SERVICE_MODE=api
AUTH_SECRET=<generate-strong-secret-at-least-32-chars>

# Host port for production container (nginx → club.nibmarket.ir)
APP_PORT=3002

# Public URLs for this Next.js front (SSO callback host — not api-club)
NEXT_PUBLIC_SITE_URL=https://club.nibmarket.ir
NEXT_PUBLIC_APP_URL=https://club.nibmarket.ir

# NIB account auth (refresh / logout) — preset default is auth.nibmarket.com
# NEXT_PUBLIC_AUTH_BASE_URL=https://auth.nibmarket.com

# Optional: leave blank to use env-presets production backend/panel
# (api-club.nibmarket.com / panel.nibmarket.com)
# BACKEND_API_BASE_URL=
