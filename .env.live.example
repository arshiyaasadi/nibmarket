# ── Zone: live (nibmarket) — club.nibmarket.com ──
# Used by docker-compose.live.yml as .env.live
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

API_SERVICE_MODE=api
AUTH_SECRET=<generate-strong-secret-at-least-32-chars>

# UI-mock demo on live (in-memory BFF). Prefer: yarn sync:live:ui
# FORCE_UI_DEV_MODE=1
# NEXT_PUBLIC_FORCE_UI_DEV_MODE=1
# NEXT_PUBLIC_UI_DEV_MODE=1
# API_SERVICE_MODE=mock

# Host port for live container (nginx → club.nibmarket.com) — same as dig
APP_PORT=3000

# Club BE (server-side BFF proxy). Preset default is club-srv.nibmarket.com
# BACKEND_API_BASE_URL=https://club-srv.nibmarket.com

# NIB account auth (refresh / logout) — preset default is auth.nibmarket.com
# NEXT_PUBLIC_AUTH_BASE_URL=https://auth.nibmarket.com

# Front public origin is NOT set here — derived from Host / browser request.
