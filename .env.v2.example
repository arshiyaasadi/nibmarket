# ── V2 / UI stack on live host ────────────────────────────────
# Used by docker-compose.v2.yml as .env.v2
# Mocks + auth bypass via FORCE_UI_DEV_MODE (works with NODE_ENV=production image)
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

FORCE_UI_DEV_MODE=1
NEXT_PUBLIC_FORCE_UI_DEV_MODE=1
UI_DEV_MODE=1
NEXT_PUBLIC_UI_DEV_MODE=1
API_SERVICE_MODE=mock

AUTH_SECRET=v2_ui_stack_auth_secret_change_me_32ch

# Host port for v2 / UI container (direct access on live host)
APP_PORT=3003

# Local-facing URLs for the UI stack
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_AUTH_BASE_URL=https://auth.nibdev.com
COOKIE_SECURE=0
