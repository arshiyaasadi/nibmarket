# ── Zone ─────────────────────────────────────────────────────
# development = nibdev URLs | production = nibmarket URLs
# Presets live in src/config/env-presets.ts — set both to the same zone.
# Club front origin is derived from the request / browser (not env).
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# ── Secrets / runtime (always per-server) ────────────────────
# UI-only development: forces fixed local mocks and bypasses auth guards.
# Ignored when NODE_ENV=production. Set both so server + browser stay offline.
# UI_DEV_MODE=1
# NEXT_PUBLIC_UI_DEV_MODE=1
API_SERVICE_MODE=api
AUTH_SECRET=dev_only_auth_secret_for_nibclub_please_change

# Test: if 1, API 401 does not clear session / redirect to session-expired
# (see src/config/feature-flags.ts). nibdev deploy turns this on by default.
# NEXT_PUBLIC_KEEP_SESSION_ON_401=1

# Dev-only: allow fake admin OTP login on /login (mobile 09173648291 / OTP 5829)
# ENABLE_DEV_ADMIN_LOGIN=1

# Cookie secure flag — production NODE_ENV → secure. Set 0 for HTTP deploys.
# COOKIE_SECURE=0

# ── Docker / deploy ──────────────────────────────────────────
# Host port mapped to container port 3000 (dig and live both default 3000)
APP_PORT=3000

# ── Optional overrides ───────────────────────────────────────
# Only set these if a preset value is wrong for your deploy.
# NEXT_PUBLIC_AUTH_BASE_URL=https://auth.nibdev.com
# BACKEND_API_BASE_URL=
# Club backend path version (default v2 — do not set to v1)
# BACKEND_API_VERSION=v2
# SSO_CHECK_TOKEN_URL=
# NEXT_PUBLIC_APP_NAME=Nib Club
# NEXT_PUBLIC_PANEL_BASE_URL=
# NEXT_PUBLIC_PANEL_LOGIN_URL=
# NEXT_PUBLIC_PANEL_PROFILE_URL=
# NEXT_PUBLIC_PANEL_USER_ACCOUNT_URL=
# NEXT_PUBLIC_SSO_CALLBACK_PATH=/login/sso
# NEXT_PUBLIC_SSO_ENTRY_COOKIE=nib_auth
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
