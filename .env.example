# Copy to `.env` then adjust. Put secrets and real tokens in `.env.local` (gitignored).

# =============================================================================
# JWT — used by axios-mock @fake-db for login /auth/me (template auth)
# =============================================================================
NEXT_PUBLIC_JWT_EXPIRATION=5m
NEXT_PUBLIC_JWT_SECRET=your-jwt-secret-change-me
NEXT_PUBLIC_JWT_REFRESH_TOKEN_SECRET=your-refresh-secret-change-me

# =============================================================================
# Dashboard + Network + Reports + Leaderboard + Twin: mock vs backend API
# docs/DATA_SOURCE.md · schema.md · schema.network.md · schema.reports.md · schema.leaderboard.md · schema.twin-token.md
# =============================================================================

# mock (default) | api
NEXT_PUBLIC_DATA_SOURCE=mock

# Backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://api-club.nibdev.com

# When DATA_SOURCE=api: empty or "all" = all slugs; or comma-separated
# Example: reports-income,leaderboard-pool-balance,manager-twin-stats
NEXT_PUBLIC_API_ENABLED=

# Fallback Bearer for API calls if user has no login token (dev/staging only)
# NEXT_PUBLIC_USER_TOKEN=Bearer your-access-token-here

# =============================================================================
# Optional — app URLs
# =============================================================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_HOST_URL=http://localhost:3000

# =============================================================================
# Optional — Docker
# =============================================================================
# NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim

# =============================================================================
# Optional — server-side health (Next.js API routes, not dashboard client)
# =============================================================================
# BACKEND_HEALTH_URL=https://api-club.nibdev.com/health
# BACKEND_SWAGGER_TEST_URL=http://192.168.8.199:8070/swagger/index.html
