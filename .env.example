# Copy to `.env` on each machine (local + live server): cp .env.example .env
# For production deploy you can also use: cp .env.production .env
# After changing NEXT_PUBLIC_* run: docker compose up --build -d

# =============================================================================
# JWT — Materialize @fake-db (template login at /login/template only)
# =============================================================================
NEXT_PUBLIC_JWT_EXPIRATION=5m
NEXT_PUBLIC_JWT_SECRET=dd5f3089-40c3-403d-af14-d0c228b05cb4
NEXT_PUBLIC_JWT_REFRESH_TOKEN_SECRET=7c4c1c50-3230-45bf-9eae-c9b2e401c767

# =============================================================================
# API — mock vs backend (docs/DATA_SOURCE.md)
# =============================================================================
NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_BASE_URL=https://api-club.nibdev.com
NEXT_PUBLIC_API_ENABLED=

# =============================================================================
# Login token
# Paste token in /login or open /login/token/{token}/.
# Exchanged via POST /api/v1/auth/check_token — not sent to other APIs after exchange.
# =============================================================================

# Materialize email/password demo (off — use /login/token/{token}/ for SSO)
# NEXT_PUBLIC_ENABLE_TEMPLATE_LOGIN=true

# =============================================================================
# App URLs (invite links + external Nibmarket panel)
# =============================================================================
# NEXT_PUBLIC_APP_URL=https://your-live-domain.example
# NEXT_PUBLIC_HOST_URL=https://your-live-domain.example

# SSO login redirect (401 logout + missing token on /)
NEXT_PUBLIC_PANEL_LOGIN_URL=https://panel.nibmarket.com/login/?callback_service=mlm

# Legacy panel — profile & account settings (full page navigation)
NEXT_PUBLIC_PANEL_BASE_URL=https://panel.nibmarket.com
NEXT_PUBLIC_PANEL_PROFILE_URL=https://panel.nibmarket.com/profile/
NEXT_PUBLIC_PANEL_USER_ACCOUNT_URL=https://panel.nibmarket.com/user-account/

# =============================================================================
# Docker
# =============================================================================
APP_PORT=3000
# NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
