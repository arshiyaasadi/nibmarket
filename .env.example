# ── Database (server-only — هرگز NEXT_PUBLIC_ اضافه نکنید) ──
# Client فقط /api/v1/* را می‌بیند؛ Prisma فقط در server route handlers استفاده می‌شود.
DATABASE_URL=postgresql://nibclub_user:YOUR_DB_PASSWORD_HERE@localhost:5432/nibclub
AUTH_SECRET=change_me_please_use_32_chars_minimum_for_dev
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SSO_CHECK_TOKEN_URL=https://panel.nibdev.com/api/v1/auth/check_token

# ── API service mode ─────────────────────────────────────────
# prisma = BFF handlers + Prisma repositories (default)
# api    = proxy all /api/v2/* requests to external backend
API_SERVICE_MODE=prisma
BACKEND_API_BASE_URL=https://api-club.nibdev.com
BACKEND_API_VERSION=v2

# ── Future backend fallback (optional, deprecated) ───────────
# BACKEND_API_URL=https://api-club.nibdev.com/api/v2

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Nib Club

# ── NIB Market SSO ───────────────────────────────────────────
NEXT_PUBLIC_SSO_CALLBACK_PATH=/login/sso
NEXT_PUBLIC_PANEL_BASE_URL=https://panel.nibdev.com
# Optional full override. If unset, app builds:
# {NEXT_PUBLIC_PANEL_BASE_URL}/login/?callbackUrl={NEXT_PUBLIC_APP_URL}{NEXT_PUBLIC_SSO_CALLBACK_PATH}/
NEXT_PUBLIC_PANEL_LOGIN_URL=
NEXT_PUBLIC_SSO_ENTRY_COOKIE=nib_auth
NEXT_PUBLIC_PANEL_PROFILE_URL=https://panel.nibdev.com/profile/
NEXT_PUBLIC_PANEL_USER_ACCOUNT_URL=https://panel.nibdev.com/user-account/

# ── Super admin (server-only, optional) ──────────────────────
SUPER_ADMIN_EMAIL=superadmin@nibclub.ir
SUPER_ADMIN_PASSWORD=CHANGE_ME

# ── Docker / deploy (optional) ───────────────────────────────
# APP_PORT=3000
# NODE_BASE_IMAGE=node:22-bookworm-slim
